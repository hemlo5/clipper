# GEMINI_API_KEY: Optional runtime key managed by AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected at runtime.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_HEMLO_API_URL: Optional public base URL for the Modal Clippy AI backend.
# Leave empty to run HEMLO in Mock Demo Mode.
NEXT_PUBLIC_HEMLO_API_URL=""
